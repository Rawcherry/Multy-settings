#!/usr/bin/env python3
"""Launcher: no arguments opens the window; --help shows the command-line options."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

if len(sys.argv) > 1 and sys.argv[1].startswith("--") and sys.argv[1] not in ("--gapplication-service",):
    from omni_settings.cli import main as cli_main

    sys.exit(cli_main(sys.argv[1:]))

try:
    from omni_settings.app import main
except (ImportError, ValueError) as e:
    print(f"omni-settings: GTK4/libadwaita for Python is missing ({e}).\n"
          "Install:  sudo pacman -S python-gobject gtk4 libadwaita", file=sys.stderr)
    sys.exit(1)
sys.exit(main())
